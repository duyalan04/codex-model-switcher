{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-model-switcher",
  "version": "0.2.0",
  "identifier": "com.zuy.codex-model-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Model Switcher",
        "width": 1024,
        "height": 580,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}